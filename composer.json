{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "zoe606/larabase",
    "type": "project",
    "description": "Production-ready Laravel 13, React, Inertia, TypeScript, and ShadCN starter",
    "keywords": [
        "laravel",
        "framework",
        "react",
        "inertia",
        "tailwind",
        "shadcn",
        "permission"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "dedoc/scramble": "^0.13.10",
        "inertiajs/inertia-laravel": "^2.0",
        "laravel/framework": "^13.0",
        "laravel/pulse": "^1.4",
        "laravel/reverb": "^1.0",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^3.0",
        "sentry/sentry-laravel": "^4.22",
        "spatie/laravel-activitylog": "^4.10",
        "spatie/laravel-backup": "^10.0",
        "spatie/laravel-medialibrary": "^11.0",
        "spatie/laravel-permission": "^6.0",
        "tightenco/ziggy": "^2.0"
    },
    "require-dev": {
        "beyondcode/laravel-query-detector": "^2.1",
        "fakerphp/faker": "^1.24",
        "fruitcake/laravel-debugbar": "^4.0",
        "larastan/larastan": "^3.8",
        "laravel/boost": "^2.5",
        "laravel/pail": "^1.2",
        "laravel/pint": "~1.27.0",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.0",
        "phpunit/phpunit": "^12.0",
        "spatie/laravel-typescript-transformer": "^2.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev:herd": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#c4b5fd,#fb7185,#fdba74,#86efac\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"pnpm run dev\" \"php artisan reverb:start\" --names=queue,logs,vite,reverb"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74,#86efac\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"pnpm run dev\" \"php artisan reverb:start\" --names=server,queue,logs,vite,reverb"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
